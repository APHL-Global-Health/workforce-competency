# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Database
DB_PATH=./data/workforce.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Sessions
SESSION_SECRET=change-me-in-production
SESSION_MAX_AGE_MS=28800000
# Override the `Secure` attribute on the session cookie. Leave unset to
# default to "true in production, false in dev". Set explicitly to "false"
# when running production behind plain HTTP (e.g. first Docker deploy before
# TLS is set up).
# SESSION_COOKIE_SECURE=false

# Number of proxy hops in front of the app. Set to 1 when running behind nginx.
TRUST_PROXY=0
