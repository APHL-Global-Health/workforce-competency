# pnpm config
# Auto-install peers so TanStack Query, Radix, and friends don't complain.
auto-install-peers=true
# Be permissive about peer version mismatches in workspace packages —
# strict mode fights too hard with React 19 + many libs that peer to React 18.
strict-peer-dependencies=false
# Keep the workspace installer quiet about hoisting.
shamefully-hoist=false
