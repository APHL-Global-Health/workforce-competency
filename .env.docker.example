# Copy this file to `.env` in the repo root. docker compose reads it automatically.
# NEVER commit the real `.env` — it's already in .gitignore.

# Required — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of origins the API will accept. For HTTP-only local
# testing, "http://localhost" is enough. When you add HTTPS + a real domain,
# change this to e.g. "https://competency.example.org".
CORS_ORIGINS=http://localhost

# Session cookie — keep "false" while the site is HTTP-only. Flip to "true"
# after HTTPS is terminating at nginx, otherwise cookies still won't be set.
SESSION_COOKIE_SECURE=false

# Session lifetime in ms (default 8h).
SESSION_MAX_AGE_MS=28800000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
