# Copy this file to `.env` in the repo root. docker compose reads it automatically.
# NEVER commit the real `.env` — it's already in .gitignore.

# Required — docker compose refuses to start while this is empty. Generate one with:
#   openssl rand -hex 48
# or, where Node.js is installed:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public host name of this server, e.g. "competency.example.org". Its DNS
# record must point at this server. Leave empty to run over plain HTTP only
# (local testing, or access by IP address).
DOMAIN=
# Optional extra host names on the same certificate, space-separated,
# e.g. "www.competency.example.org".
DOMAIN_ALIASES=
# Contact address for Let's Encrypt expiry notices. Setting it (together with
# DOMAIN) makes the certbot service request a certificate, which accepts the
# Let's Encrypt Subscriber Agreement. nginx switches to HTTPS once it exists.
LETSENCRYPT_EMAIL=

# Comma-separated list of origins the API will accept: the exact scheme and
# host name people use in the browser. With HTTPS, e.g.
# "https://competency.example.org". For HTTP-only local testing,
# "http://localhost" is enough.
CORS_ORIGINS=http://localhost,http://localhost:8066,http://127.0.0.1:8066
#CORS_ORIGINS=https://competency.example.org

# Session cookie — keep "false" while the site is HTTP-only. Flip to "true"
# once nginx serves HTTPS, then run `docker compose up -d` again.
SESSION_COOKIE_SECURE=false

# Session lifetime in ms (default 8h).
SESSION_MAX_AGE_MS=28800000

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
